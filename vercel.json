{
  "version": 2,
  "name": "ataraxia-stoic",
  "buildCommand": "cd ataraxia && npm install && npm run build",
  "outputDirectory": "ataraxia/dist",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
