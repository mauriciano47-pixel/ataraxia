{
  "expo": {
    "name": "Ataraxia - Stoic Fitness",
    "slug": "ataraxia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ataraxia",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ataraxia.app",
      "infoPlist": {
        "NSMotionUsageDescription": "Ataraxia requiere acceso a tus sensores de movimiento para registrar tus pasos y calcular tu gasto de energía diario las 24 horas."
      }
    },
    "android": {
      "package": "com.ataraxia.app",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "themeColor": "#050505",
      "backgroundColor": "#050505",
      "name": "Ataraxia - Stoic Fitness",
      "shortName": "Ataraxia",
      "description": "Coach de Fitness, Nutrición y Rendimiento Estoico",
      "display": "standalone"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sensors",
        {
          "motionPermission": "Ataraxia requiere acceso a tus sensores de movimiento para registrar tus pasos y calcular tu gasto de energía diario las 24 horas."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 110
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/ataraxia",
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e6631a9a-b2f5-4f3a-8601-fa5c54a251f1"
      }
    }
  }
}
